import Foundation
import SwiftUI

// sourcery: register
final class {{ argument.component }}ComponentRegister: ComponentRegister {
    var contentType: String {
        "{{ argument.component | lowercase }}"
    }

    var propertiesType: Properties.Type {
        {{ argument.component }}Properties.self
    }

    func viewModel(from component: Component,  dependency: ExperienceDependency) -> AnyComponentViewModel {
        AnyComponentViewModel({{ argument.component }}ViewModel(any: component.properties,
                                                                dependency: dependency,
                                                                id: component.id),
                              contentType: contentType)
    }

    func view(from viewModel: any ComponentViewModel) -> AnyView {
        return AnyView({{ argument.component }}View(any: viewModel))
    }
}
